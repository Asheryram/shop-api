# How the infra platform runs this repo. (Copied from infra/app-kit and filled in.)
APP_NAME=shop-api
TYPE=backend
# On a real server with GitHub: ghcr.io/<owner>/shop-api   — locally: images built on the server itself
IMAGE_REPO=local/shop-api

API_CONTEXT=.
API_PORT=8080
MIGRATE_CMD='python migrate.py'

# A feature that needs a secret? Declare it here in the same PR — the deploy waits until DevOps sets it:
# API_REQUIRED_ENV="PAYMENT_API_KEY"
